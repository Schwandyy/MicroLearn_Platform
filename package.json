    "eslint-config-next": "14.2.18",
    "jsonrepair": "^3.14.0",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "prisma": "^6.0.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {}
}
