{
  "name": "microlearn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build",
    "start": "next start -p 3030",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:seed:curriculum": "tsx --env-file=.env scripts/seed-curriculum.ts",
    "db:seed:badges": "tsx --env-file=.env scripts/seed-badges.ts",
    "db:fix:setup-bom": "tsx --env-file=.env scripts/fix-setup-bom.ts",
    "db:audit:boms": "tsx --env-file=.env scripts/audit-boms.ts",
    "verify:affiliate": "tsx --env-file=.env scripts/verify-affiliate-links.ts",
    "sync:affiliate": "tsx --env-file=.env scripts/sync-affiliate-links.ts",
    "lessons:generate": "tsx --env-file=.env.local scripts/generate-lesson.ts",
    "mobile:add:ios": "cap add ios",
    "mobile:add:android": "cap add android",
    "mobile:sync": "cap sync",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "mobile:assets:placeholders": "node scripts/generate-placeholder-assets.mjs",
    "screenshots:store": "node scripts/generate-screenshots.mjs",
    "screenshots:capture-session": "node scripts/capture-screenshot-session.mjs",
    "mobile:assets": "capacitor-assets generate --iconBackgroundColor=#0b1220 --iconBackgroundColorDark=#0b1220 --splashBackgroundColor=#0b1220 --splashBackgroundColorDark=#0b1220 --ios --android",
    "postinstall": "prisma generate"
  },
  "dependencies": {
