{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/scrape",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/streak-reminders",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/monthly-parent-digest",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/api/cron/stuck-detection",
      "schedule": "*/5 * * * *"
    }
  ]
}
