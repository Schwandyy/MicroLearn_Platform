# =============================================================================
# MicroLearn — Environment Variables
# Copy to .env.local and fill in. NEVER commit .env or .env.local.
# =============================================================================

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3030
PORT=3030

# --- Database (Postgres via Docker Compose) ---
# docker compose up -d  →  see docker-compose.yml
DATABASE_URL="postgresql://microlearn:microlearn@localhost:5432/microlearn?schema=public"

# --- NextAuth.js v5 ---
# Generate secret: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3030"

# --- OAuth Providers ---
# Google: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub: https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Apple: https://developer.apple.com/account/resources/identifiers/list
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# SAML / SSO (Institution-Tier) — boxyhq/saml-jackson recommended
SAML_JACKSON_URL=""
SAML_JACKSON_API_KEY=""

# --- Stripe (Pro 9,99€ / Institution 49€) ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_INSTITUTION=""

# --- Anthropic Claude API ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# --- Wokwi (Simulator) ---
# Serverseitig: NIEMALS NEXT_PUBLIC_ prefixen
WOKWI_API_KEY=""

# --- MeiliSearch ---
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY=""

# --- Cloudflare R2 (Storage) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# --- Upstash Redis (Rate Limiting) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Web Push (Streak-Notifications) ---
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:habedank@az-delivery.com"
