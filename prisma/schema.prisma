// =============================================================================
// MicroLearn — Prisma Schema
// PostgreSQL, two-language content fields (DE + EN) on every public artefact.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  STUDENT // default end-user
  STUDENT_CODE // class-code user (no PII, see Schüler-Code system)
  INSTRUCTOR // verified content creator
  TEACHER // classroom owner
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  INSTITUTION
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum LearnerLevel {
  L1_BEGINNER
  L2_NOVICE
  L3_INTERMEDIATE
  L4_EXPERT
}

enum LogicLevel {
  V3_3
  V5
  BOTH
}

enum Protocol {
  GPIO
  PWM
  ADC
  DAC
  I2C
  SPI
  UART
  ONEWIRE
  CAN
  BLE
  WIFI
  MQTT
  ETHERNET
}

enum ContentSource {
  HACKSTER
  AZ_DELIVERY
  ARDUINO_OFFICIAL
  RANDOM_NERD_TUTORIALS
  ADAFRUIT_LEARN
  SPARKFUN_LEARN
  PIMORONI_LEARN
  GITHUB_README
  USER_GENERATED
  EDITORIAL
}

enum ReviewStatus {
  PENDING
  AI_FLAGGED
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  PUBLISHED
}

enum ProjectKind {
  CONCEPT
  PROJECT
}

enum QuizKind {
  MINI // inside a lesson, low stakes
  ASSESSMENT // initial 8-question placement
  LESSON_FINAL // grants XP at the end of a lesson
}

enum StepKind {
  INTRO // "Was bauen wir?" — Cover + 1-2 sentences
  PARTS // BOM presentation
  SAFETY // safety warning step
  BUILD // breadboard build step (image + instruction)
  CODE_WALK // code walkthrough with line explanations
  SIMULATE // run-the-program preview (own simulator stub)
  QUIZ // mini quiz question
  CELEBRATE // success screen
  EXPLAIN // pure concept explanation with visual
  SETUP // software setup with download links and ordered checklist
}

enum NotificationType {
  COMMENT
  LIKE
  ASSIGNMENT
  LESSON_PUBLISHED
  SYSTEM
  HELP_REQUEST
}

enum HelpRequestSource {
  AUTO_STUCK // detected by cron
  STUDENT_RAISED // student tapped "ask teacher"
}

enum BadgeCategory {
  MILESTONE
  STREAK
  COMMUNITY
  MASTERY
}

enum AffiliateMerchant {
  AZ_DELIVERY
  BERRYBASE
  REICHELT
  AMAZON_DE
}

// -----------------------------------------------------------------------------
// Auth & Identity
// -----------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  emailVerified   DateTime?
  name            String?
  username        String?   @unique
  image           String?
  passwordHash    String?
  role            UserRole  @default(STUDENT)
  preferredLocale       String  @default("de")
  marketingOptIn        Boolean @default(false)
  weeklyDigestOptOut    Boolean @default(false)

  // Optional Eltern-/Guardian-Mail für Monatsbericht (DSGVO: explizites
  // Opt-in nötig; Schüler-Code-Accounts können das nicht setzen).
  parentEmail                String?
  monthlyParentDigestOptOut  Boolean @default(false)
  monthlyParentDigestLastAt  DateTime?

  // Schüler-Code-System
  classroomMember ClassroomMember?

  // Relations
  profile           Profile?
  accounts          Account[]
  sessions          Session[]
  subscription      Subscription?
  progress          UserProgress[]
  assessments       AssessmentResult[]
  quizResults       QuizResult[]
  badges            UserBadge[]
  streak            Streak?
  xp                XPTransaction[]
  certificates      Certificate[]
  projects          Project[]
  projectLikes      ProjectLike[]
  comments          Comment[]
  pushSubscriptions PushSubscription[]
  classroomsTaught  Classroom[]        @relation("ClassroomTeacher")
  reviewsAuthored   ContentReview[]    @relation("ReviewAuthor")
  notifications     Notification[]
  helpRequests      HelpRequest[]      @relation("HelpRequestStudent")
  helpResolutions   HelpRequest[]      @relation("HelpRequestResolver")
  institutionAdminships InstitutionAdmin[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                  String       @id @default(cuid())
  userId              String       @unique
  bio                 String?
  country             String?
  birthYear           Int?
  currentLevel        LearnerLevel @default(L1_BEGINNER)
  favoriteBoardIds    String[]     @default([])
  starterCompletedAt  DateTime?
  starterMode         String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Subscriptions
// -----------------------------------------------------------------------------

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Hardware catalog
// -----------------------------------------------------------------------------

model Board {
  id                  String  @id @default(cuid())
  slug                String  @unique
  name                String
  manufacturer        String?
  family              String? // ESP32, AVR, RP2040, STM32, …
  imageUrl            String?
  iconKey             String? // Lucide icon name fallback
  descriptionShort_de String?
  descriptionShort_en String?

  logicLevel LogicLevel
  voltageMin Float
  voltageMax Float
  protocols  Protocol[] @default([])

  // i18n content
  description_de String @db.Text
  description_en String @db.Text

  // Catalog links
  affiliateLinks AffiliateLink[]

  bomItems   BOMItem[]
  components ComponentBoardCompat[]
  lessons    Lesson[]               @relation("LessonRecommendedBoards")
  projects   Project[]              @relation("ProjectBoards")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Component {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  category String // sensor, actuator, display, power, …
  imageUrl String?
  iconKey  String? // Lucide icon name fallback

  logicLevel LogicLevel
  voltageMin Float
  voltageMax Float
  protocols  Protocol[] @default([])

  description_de      String        @db.Text
  description_en      String        @db.Text
  // One-line, child-friendly summary used in BOM cards
  descriptionShort_de String?
  descriptionShort_en String?
  // Beginner-suitability hint: which levels typically use this part
  levelHint           LearnerLevel?

  affiliateLinks AffiliateLink[]
  bomItems       BOMItem[]
  boards         ComponentBoardCompat[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComponentBoardCompat {
  componentId String
  boardId     String
  // Explicit verified compatibility; absence ≠ incompatible, but UI prefers verified
  notes_de    String?
  notes_en    String?

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([componentId, boardId])
}

// -----------------------------------------------------------------------------
// Affiliate
// -----------------------------------------------------------------------------

model AffiliateProgram {
  id            String            @id @default(cuid())
  merchant      AffiliateMerchant @unique
  displayName   String
  urlTemplate   String // e.g. https://www.az-delivery.de/products/{slug}?ref={trackingId}
  trackingId    String?
  isActive      Boolean           @default(true)
  lastCheckedAt DateTime?
  notes         String?

  links AffiliateLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AffiliateLink {
  id             String    @id @default(cuid())
  programId      String
  productUrl     String // canonical product URL on merchant
  productSlug    String?
  priceCents     Int?
  currency       String?   @default("EUR")
  inStock        Boolean?
  lastSyncedAt   DateTime?
  // Optional pack-size note (e.g. "65er M/M-Set") shown under the buy-button
  packageNote_de String?
  packageNote_en String?

  program AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  componentId String?
  component   Component? @relation(fields: [componentId], references: [id])

  boardId String?
  board   Board?  @relation(fields: [boardId], references: [id])

  bomItems BOMItem[]

  @@index([componentId])
  @@index([boardId])
}

// -----------------------------------------------------------------------------
// Learning content
// -----------------------------------------------------------------------------

model LearningPath {
  id             String       @id @default(cuid())
  slug           String       @unique
  level          LearnerLevel
  estimatedHours Int?
  coverImage     String?
  sortOrder      Int          @default(0)

  title_de   String
  title_en   String
  summary_de String @db.Text
  summary_en String @db.Text

  courses      Course[]
  userProgress UserProgress[]
  certificates Certificate[]
  assignments  ClassroomAssignment[]

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id        String @id @default(cuid())
  pathId    String
  slug      String @unique
  sortOrder Int    @default(0)

  title_de   String
  title_en   String
  summary_de String @db.Text
  summary_en String @db.Text

  path    LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id               String      @id @default(cuid())
  courseId         String
  slug             String      @unique
  sortOrder        Int         @default(0)
  kind             ProjectKind @default(CONCEPT)
  xpReward         Int         @default(50)
  estimatedMinutes Int?

  title_de       String
  title_en       String
  // Short "what will I build?" — shown on cover step
  summary_de     String  @db.Text
  summary_en     String  @db.Text
  // Legacy long-form body, kept for expert level + fallback rendering
  body_de        String  @db.Text
  body_en        String  @db.Text
  coverImage     String?
  codeSnippet    String? @db.Text
  safetyNotes_de String? @db.Text
  safetyNotes_en String? @db.Text

  // Optional WebSerial flash (Chrome/Edge only)
  firmwareUrl          String?
  firmwareChip         String? // "esp32" | "esp32s3" | "esp32c3" | "esp32s2" | "esp8266"
  firmwareFlashAddress String? // e.g. "0x10000" (default 0x10000 for ESP32 Arduino sketch)

  // Compatibility
  recommendedBoards Board[]          @relation("LessonRecommendedBoards")
  bom               BOMItem[]
  quizzes           Quiz[]
  scrapedSources    ScrapedContent[]
  review            ContentReview?
  progress          UserProgress[]
  steps             LessonStep[]
  assignments       ClassroomAssignment[]
  curriculumLinks   LessonCurriculumStandard[]
  helpRequests      HelpRequest[]

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  // Hardware-Verifikation: gesetzt wenn die Lesson auf echter Hardware
  // nachgebaut und erfolgreich durchgespielt wurde. Lessons ohne diesen
  // Stempel dürfen im Frontend einen „In Überarbeitung"-Hinweis tragen.
  verifiedOnHardwareAt DateTime?
  verifiedOnHardwareBy String?   // User-ID der Lehrkraft/Admin
  // Strukturierte 6-Punkt-Checkliste { bom, schematic, codeCompiles, flashOk, expectedResult, quizAnswers, notes? }
  verificationChecklist Json?
  verifications LessonVerification[]

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Audit-Trail einer Hardware-Verifikation. Jeder Re-Audit erzeugt einen
// neuen Eintrag — die aktuelle Verifikation lebt direkt auf Lesson, hier
// liegt die Historie + Rohdaten der Checkliste.
model LessonVerification {
  id        String   @id @default(cuid())
  lessonId  String
  verifiedBy String  // User-ID
  verifiedAt DateTime @default(now())
  // { bom: bool, schematic: bool, codeCompiles: bool, flashOk: bool, expectedResult: bool, quizAnswers: bool, notes?: string }
  checklist Json
  passed    Boolean  @default(true)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, verifiedAt])
}

// One step within a lesson. Drives the Step-Player UI.
model LessonStep {
  id        String   @id @default(cuid())
  lessonId  String
  sortOrder Int      @default(0)
  kind      StepKind

  // Bilingual content
  title_de String?
  title_en String?
  body_de  String? @db.Text
  body_en  String? @db.Text

  // Optional visuals + payload — interpretation depends on `kind`
  imageUrl String? // url to step image (breadboard photo etc.)
  payload  Json? // structured: { code, lineNotes, breadboard, animation, ... }

  // Quiz steps reuse Quiz model
  quizId String?
  quiz   Quiz?   @relation(fields: [quizId], references: [id], onDelete: SetNull)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, sortOrder])
}

model BOMItem {
  id        String  @id @default(cuid())
  lessonId  String?
  projectId String?
  quantity  Int     @default(1)
  note_de   String?
  note_en   String?

  componentId String?
  component   Component? @relation(fields: [componentId], references: [id])

  boardId String?
  board   Board?  @relation(fields: [boardId], references: [id])

  affiliateLinkId String?
  affiliateLink   AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])

  lesson  Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Scraping + Review pipeline
// -----------------------------------------------------------------------------

model ScrapedContent {
  id             String        @id @default(cuid())
  source         ContentSource
  sourceUrl      String        @unique
  fetchedAt      DateTime      @default(now())
  rawHtml        String        @db.Text
  parsedTitle    String?
  parsedMarkdown String?       @db.Text
  language       String? // ISO 639-1, detected
  notes          String?

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id])

  review ContentReview?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentReview {
  id     String       @id @default(cuid())
  status ReviewStatus @default(PENDING)

  lessonId  String? @unique
  scrapedId String? @unique

  // AI pre-check report (logic, safety, compatibility, language quality)
  aiFlags      Json?
  aiSummary_de String? @db.Text
  aiSummary_en String? @db.Text

  // Reviewer
  authorId      String?
  reviewerNotes String?   @db.Text
  decidedAt     DateTime?

  lesson  Lesson?         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  scraped ScrapedContent? @relation(fields: [scrapedId], references: [id], onDelete: Cascade)
  author  User?           @relation("ReviewAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Progress / gamification
// -----------------------------------------------------------------------------

model UserProgress {
  id       String  @id @default(cuid())
  userId   String
  pathId   String?
  lessonId String?

  percentage  Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  lastSeenAt  DateTime  @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  path   LearningPath? @relation(fields: [pathId], references: [id], onDelete: Cascade)
  lesson Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, pathId])
}

model AssessmentResult {
  id      String       @id @default(cuid())
  userId  String
  score   Int // 0..100
  level   LearnerLevel
  answers Json
  takenAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
}

model Quiz {
  id        String   @id @default(cuid())
  lessonId  String?
  kind      QuizKind @default(LESSON_FINAL)
  title_de  String
  title_en  String
  questions Json // [{id, prompt_de, prompt_en, options:[{key,label_de,label_en}], correctKey, weight}]
  passScore Int      @default(70)

  lesson  Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  results QuizResult[]
  steps   LessonStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuizResult {
  id      String   @id @default(cuid())
  quizId  String
  userId  String
  score   Int
  passed  Boolean
  answers Json
  takenAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
}

model Badge {
  id             String        @id @default(cuid())
  slug           String        @unique
  category       BadgeCategory
  iconUrl        String?
  xpReward       Int           @default(0)
  title_de       String
  title_en       String
  description_de String        @db.Text
  description_en String        @db.Text

  users UserBadge[]
}

model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

model Streak {
  id               String    @id @default(cuid())
  userId           String    @unique
  currentDays      Int       @default(0)
  longestDays      Int       @default(0)
  lastActiveDay    DateTime?
  freezesRemaining Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id       String  @id @default(cuid())
  userId   String
  endpoint String  @unique
  p256dh   String
  auth     String
  locale   String  @default("de")
  enabled  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, enabled])
}

model XPTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String // 'LESSON_COMPLETE', 'QUIZ_PERFECT', 'STREAK_BONUS', …
  refId     String? // optional pointer to lesson/quiz/project
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Certificate {
  id         String   @id @default(cuid())
  userId     String
  pathId     String
  pdfUrl     String?
  issuedAt   DateTime @default(now())
  publicSlug String   @unique

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId])
}

// -----------------------------------------------------------------------------
// User-generated content (Pro)
// -----------------------------------------------------------------------------

model Project {
  id         String  @id @default(cuid())
  authorId   String
  slug       String  @unique
  title_de   String
  title_en   String
  body_de    String  @db.Text
  body_en    String  @db.Text
  coverImage String?
  isPublic   Boolean @default(false)

  bom      BOMItem[]
  showcase ProjectShowcase?
  comments Comment[]
  boards   Board[]          @relation("ProjectBoards")
  likes    ProjectLike[]

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model ProjectLike {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

model ProjectShowcase {
  id         String   @id @default(cuid())
  projectId  String   @unique
  featuredAt DateTime @default(now())
  rank       Int?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String  @id @default(cuid())
  authorId  String
  projectId String?
  body      String  @db.Text

  author  User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Institutions / classrooms
// -----------------------------------------------------------------------------

model Institution {
  id           String  @id @default(cuid())
  name         String
  country      String?
  state        String? // BW, BY, NRW, …
  contactEmail String?

  classrooms Classroom[]
  saml       SAMLConfig?
  // 1:1 — gesetzt sobald die Schule entweder im Pilot ist oder gekauft hat
  subscription InstitutionSubscription?
  // Schul-Admin(s): Direktor:in oder IT — können Lehrkräfte einladen, Lizenz verwalten
  admins InstitutionAdmin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Schul-Lizenz (Pilot oder bezahlt). Parallel zu Subscription auf User-Ebene —
// jeder User in einer Klasse einer Institution mit aktiver (oder trialing)
// InstitutionSubscription bekommt Pro-Entitlement, ohne selbst zu zahlen.
model InstitutionSubscription {
  id                   String             @id @default(cuid())
  institutionId        String             @unique
  tier                 SubscriptionTier   @default(INSTITUTION)
  status               SubscriptionStatus @default(TRIALING)
  seats                Int                @default(30)
  // Pilot oder Stripe?
  isPilot              Boolean            @default(true)
  pilotStartedAt       DateTime           @default(now())
  trialEndsAt          DateTime?
  // Stripe-Felder leer solange isPilot=true
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  // Geschätzte Anzahl Schüler (für Sales-Funnel + Lizenz-Aufstockung)
  estimatedStudentCount Int?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, trialEndsAt])
}

// Schul-Admin-Verknüpfung. Ein User kann Admin mehrerer Institutionen sein
// (z.B. Schulträger). Rolle bleibt auf User.role, hier nur die Verknüpfung.
model InstitutionAdmin {
  id            String   @id @default(cuid())
  institutionId String
  userId        String
  invitedAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
  @@index([userId])
}

model SAMLConfig {
  id            String @id @default(cuid())
  institutionId String @unique
  metadataXml   String @db.Text
  acsUrl        String
  entityId      String

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model Classroom {
  id            String  @id @default(cuid())
  institutionId String?
  teacherId     String
  name          String
  curriculumTag String? // legacy freeform tag, deprecated by state+grade below
  // Optional curriculum scope of the class. When set, lessons can be matched
  // against CurriculumStandard rows for this state + grade.
  state         String? // e.g. "BW", "BY", "NRW"
  grade         Int? // e.g. 9

  institution Institution? @relation(fields: [institutionId], references: [id])
  teacher     User         @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  members      ClassroomMember[]
  codes        ClassroomCode[]
  assignments  ClassroomAssignment[]
  helpRequests HelpRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, grade])
}

model HelpRequest {
  id          String            @id @default(cuid())
  studentId   String
  lessonId    String
  classroomId String?
  source      HelpRequestSource
  message     String?           @db.Text
  resolvedAt  DateTime?
  resolvedById String?
  createdAt   DateTime          @default(now())

  student    User       @relation("HelpRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  resolvedBy User?      @relation("HelpRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  classroom  Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@index([classroomId, resolvedAt])
  @@index([studentId, lessonId, resolvedAt])
}

model ClassroomCode {
  id          String   @id @default(cuid())
  classroomId String
  code        String   @unique
  expiresAt   DateTime
  maxUses     Int      @default(50)
  uses        Int      @default(0)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
}

model ClassroomMember {
  id          String   @id @default(cuid())
  classroomId String
  userId      String   @unique
  joinedAt    DateTime @default(now())
  isActive    Boolean  @default(true)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classroomId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?          @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model ClassroomAssignment {
  id          String    @id @default(cuid())
  classroomId String
  pathId      String?
  lessonId    String?
  dueAt       DateTime?
  note        String?   @db.Text

  classroom Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  path      LearningPath? @relation(fields: [pathId], references: [id], onDelete: Cascade)
  lesson    Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([classroomId])
}

// -----------------------------------------------------------------------------
// Curriculum / Lehrplan-Mapping (BW, BY, NRW MINT-Curricula etc.)
// -----------------------------------------------------------------------------

model CurriculumStandard {
  id             String  @id @default(cuid())
  country        String  @default("DE")
  state          String // "BW", "BY", "NRW", …
  grade          Int // 5..13
  subject        String // "NwT", "Informatik", "Physik", "Technik", "MINT"
  code           String // e.g. "BW-NwT-9-EL-01"
  title_de       String
  title_en       String
  description_de String? @db.Text
  description_en String? @db.Text
  sortOrder      Int     @default(0)

  lessons LessonCurriculumStandard[]

  @@unique([state, code])
  @@index([state, grade])
  @@index([state, grade, subject])
}

model LessonCurriculumStandard {
  lessonId   String
  standardId String

  lesson   Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  standard CurriculumStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@id([lessonId, standardId])
  @@index([standardId])
}
